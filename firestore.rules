rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId)
        && (!('readNotificationIds' in request.resource.data)
          || (request.resource.data.readNotificationIds is list
            && request.resource.data.readNotificationIds.size() <= 500));
      // Existing large histories can remain unchanged during profile updates.
      allow update: if isSelf(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readNotificationIds'])
          || (request.resource.data.readNotificationIds is list
            && request.resource.data.readNotificationIds.size() <= 500));
      allow delete: if false;
    }

    match /tools/{toolId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /loan/{loanId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /meta/{docId} {
      allow read, write: if signedIn();
    }
  }
}
